{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvd.com/airline/fleet/v1/fleet-schema.json",
  "title": "Fleet",
  "description": "Reference JSON Schema for Section 02 / Lecture 05. Mirrors fleet.xsd field-for-field — pattern restrictions, enum values, required keys, cardinality. Draft 2020-12, the latest IETF spec (also what networknt validates by default).",
  "type": "object",
  "additionalProperties": false,
  "required": ["airports", "aircraftModels", "aircraft", "routes", "flights"],
  "properties": {
    "airports":       { "type": "array", "items": { "$ref": "#/$defs/Airport" } },
    "aircraftModels": { "type": "array", "items": { "$ref": "#/$defs/AircraftModel" } },
    "aircraft":       { "type": "array", "items": { "$ref": "#/$defs/Aircraft" } },
    "routes":         { "type": "array", "items": { "$ref": "#/$defs/Route" } },
    "flights":        { "type": "array", "items": { "$ref": "#/$defs/Flight" } }
  },

  "$defs": {

    "IataCode":    { "type": "string", "pattern": "^[A-Z]{3}$" },
    "TailNumber":  { "type": "string", "pattern": "^[A-Z]{1,2}-[A-Z0-9]{2,5}$" },
    "CountryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "FlightStatus": {
      "type": "string",
      "enum": ["SCHEDULED", "BOARDING", "DEPARTED", "ARRIVED", "CANCELLED"]
    },

    "Airport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iata", "name", "city", "countryCode", "timezone"],
      "properties": {
        "iata":        { "$ref": "#/$defs/IataCode" },
        "name":        { "type": "string", "minLength": 1 },
        "city":        { "type": "string", "minLength": 1 },
        "countryCode": { "$ref": "#/$defs/CountryCode" },
        "timezone":    { "type": "string", "minLength": 1 }
      }
    },

    "AircraftModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manufacturer", "modelName", "capacity", "rangeKm"],
      "properties": {
        "id":           { "type": "integer", "minimum": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "modelName":    { "type": "string", "minLength": 1 },
        "capacity":     { "type": "integer", "minimum": 1 },
        "rangeKm":      { "type": "integer", "minimum": 1 }
      }
    },

    "Aircraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tailNumber", "modelId", "inService"],
      "properties": {
        "tailNumber":  { "$ref": "#/$defs/TailNumber" },
        "modelId":     { "type": "integer", "minimum": 1 },
        "inService":   { "type": "boolean" },
        "deliveredOn": { "type": "string", "format": "date" }
      }
    },

    "Route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originAirportIata", "destinationAirportIata", "distanceKm", "typicalDurationMin"],
      "properties": {
        "id":                     { "type": "integer", "minimum": 1 },
        "originAirportIata":      { "$ref": "#/$defs/IataCode" },
        "destinationAirportIata": { "$ref": "#/$defs/IataCode" },
        "distanceKm":             { "type": "integer", "minimum": 1 },
        "typicalDurationMin":     { "type": "integer", "minimum": 1 }
      }
    },

    "Flight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "routeId", "scheduledDep", "scheduledArr", "status"],
      "properties": {
        "number":       { "type": "string", "minLength": 1 },
        "routeId":      { "type": "integer", "minimum": 1 },
        "aircraftTail": { "$ref": "#/$defs/TailNumber" },
        "scheduledDep": { "type": "string", "format": "date-time" },
        "scheduledArr": { "type": "string", "format": "date-time" },
        "status":       { "$ref": "#/$defs/FlightStatus" }
      }
    }
  }
}
